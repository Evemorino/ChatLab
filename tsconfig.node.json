{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "paths": {
      "@openchatlab/*": ["./packages/*"],
      "chatlab-mcp": ["./packages/mcp-server/src"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/bin/**", "**/*.test.ts", "**/*.spec.ts"]
}
