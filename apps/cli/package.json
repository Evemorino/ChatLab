{
  "name": "chatlab-cli",
  "version": "0.37.2",
  "description": "ChatLab CLI & Service - Chat history analysis tool",
  "type": "module",
  "bin": {
    "chatlab": "bin/chatlab.mjs",
    "clb": "bin/chatlab.mjs"
  },
  "main": "./dist/index.mjs",
  "files": [
    "bin/",
    "dist/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChatLab/ChatLab.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/ChatLab/ChatLab",
  "keywords": [
    "chatlab",
    "chat",
    "analysis",
    "cli"
  ],
  "scripts": {
    "cli": "node ../../scripts/ensure-node-native.mjs --out apps/cli/native && tsx src/cli.ts",
    "build": "tsup && node ../../scripts/check-build-artifacts.mjs cli",
    "ensure-native": "node ../../scripts/ensure-node-native.mjs --out apps/cli/native",
    "rebuild-sqlite": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^12.4.6",
    "commander": "^13.1.0",
    "fastify": "^5.8.4",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "smol-toml": "^1.3.1",
    "sqlite-vec": "^0.1.9",
    "stream-json": "^1.9.1",
    "zod": "^3.24.4"
  },
  "optionalDependencies": {
    "@node-rs/jieba": "^2.0.1"
  },
  "devDependencies": {
    "@openchatlab/config": "workspace:*",
    "@openchatlab/core": "workspace:*",
    "@openchatlab/http-routes": "workspace:*",
    "@openchatlab/node-runtime": "workspace:*",
    "@openchatlab/parser": "workspace:*",
    "@openchatlab/shared-types": "workspace:*",
    "@openchatlab/sync": "workspace:*",
    "@openchatlab/tools": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "chatlab-mcp": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0"
  }
}
